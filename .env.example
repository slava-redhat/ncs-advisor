# --- Reasoning model ----------------------------------------------------------
# With Vertex settings absent, the app uses GitHub Copilot. Set
# COPILOT_GITHUB_TOKEN in the host shell; compose forwards it to the UI container.
NCS_COPILOT_MODEL=auto
# Available model IDs depend on your Copilot plan and organization policy.
# Check the Copilot CLI `/model` picker; examples:
# NCS_COPILOT_MODEL=gpt-6-luna
# NCS_COPILOT_MODEL=gpt-5.4-nano
# NCS_COPILOT_MODEL=claude-sonnet-5.5
# NCS_COPILOT_MODEL=gemini-3.8-flash
# Optional override: NCS_LLM_PROVIDER=vertex|copilot. Unset selects Vertex when
# ANTHROPIC_VERTEX_PROJECT_ID is set, Copilot otherwise.
# Vertex (uncomment to use):
# ANTHROPIC_VERTEX_PROJECT_ID=itpc-XXXXXXXX
# Anthropic-on-Vertex needs a real region (not "global"). us-east5 serves Claude.
# NCS_VERTEX_LOCATION=us-east5
# NCS_LLM_MODEL=claude-haiku-4-5@20251001
# ADC file in repo root (gitignored): copy from
#   ~/.config/gcloud/application_default_credentials.json
# GOOGLE_APPLICATION_CREDENTIALS=./.application_default_credentials.json

# --- Generic CVE lookup (NVD) -------------------------------------------------
# Optional; add only if you hit 429 rate limits.
# NVD_API_KEY=

# --- Observability: LangSmith tracing (optional) ------------------------------
# Off by default. Uncomment to trace every graph run (router decision, retrieved
# chunks, synthesis) — the fastest way to debug a wrong answer. Forwarded to the
# ui container automatically via env_file. (LANGSMITH_* names also work.)
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=ls__your_key_here
# LANGCHAIN_PROJECT=ncs-advisor

# --- Embeddings (RAG): HOST Ollama, GPU ---------------------------------------
# Host daemon must listen beyond localhost so containers can reach it:
#   systemctl --user set-environment OLLAMA_HOST=0.0.0.0:11434 && systemctl --user restart ollama
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_HOST=http://host.containers.internal:11434

# --- Postgres + pgvector ------------------------------------------------------
POSTGRES_USER=ncs
POSTGRES_PASSWORD=ncs
POSTGRES_DB=ncs
PGHOST=db
PGPORT=5432

# --- Conversation persistence -------------------------------------------------
# LangGraph chat history is stored in Postgres (not by Vertex) and survives
# app/container restarts.
NCS_CHECKPOINT=postgres
